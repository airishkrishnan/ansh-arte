# Copy to .env.local for local development. On Cloudflare, add these in the
# Worker's settings (both as build variables and as runtime variables).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Your live address, no trailing slash (used for SEO, sitemap and WhatsApp links)
NEXT_PUBLIC_SITE_URL=https://ansh-arte.example.workers.dev

# Shows "Continue with Google" on the sign-in page. Set to on after setting up
# Google in Supabase (SETUP.md, step 4E).
NEXT_PUBLIC_GOOGLE_SIGNIN=

# New-order phone notifications (free ntfy app). Pick a long, hard-to-guess name.
NTFY_TOPIC=ansh-arte-orders-change-me

# Optional: Telegram notifications instead of / as well as ntfy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Order emails to customers (Brevo API key, and a sender email verified in Brevo).
# Server-only: add both as secrets in the Worker's settings. See SETUP.md, step 8.
BREVO_API_KEY=
ORDER_EMAIL_FROM=

# Visitor analytics (optional, both free). Google Analytics 4 measurement ID
# (G-XXXXXXXXXX) and/or a Cloudflare Web Analytics token. Build variables.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Google Search Console "HTML tag" verification: only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
