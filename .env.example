# Copy to .env.local for local development. On Cloudflare, add these in the
# Worker's settings (both as build variables and as runtime variables).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Your live address, no trailing slash (used for SEO, sitemap and WhatsApp links)
NEXT_PUBLIC_SITE_URL=https://ansh-arte.example.workers.dev

# New-order phone notifications (free ntfy app). Pick a long, hard-to-guess name.
NTFY_TOPIC=ansh-arte-orders-change-me

# Optional: Telegram notifications instead of / as well as ntfy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
